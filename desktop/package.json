{
  "name": "plc-tag-monitor",
  "version": "1.0.0",
  "description": "Mitsubishi PLC Tag Monitor — Desktop Data Collector",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build:win": "electron-builder --win",
    "build:mac": "electron-builder --mac"
  },
  "build": {
    "appId": "com.tagmonitor.plc",
    "productName": "PLC Tag Monitor",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "PLC Tag Monitor",
      "include": "installer.nsh"
    },
    "extraResources": [
      {
        "from": "../dist_backend/run_web",
        "to": "backend/run_web",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "../",
        "to": "backend",
        "filter": [
          "app.py",
          "plc_poller.py",
          "database.py",
          "config.py",
          "schemas.py",
          "shift_manager.py",
          "run_web.py",
          "system_config.json",
          "line_config.json",
          "register_config.json",
          "requirements.txt",
          "setup_environment.ps1",
          "static/**"
        ]
      }
    ]
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.0"
  }
}

